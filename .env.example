# 去 https://my.telegram.org 用闲置手机号申请，几分钟就好
TG_API_ID=
TG_API_HASH=

# 接收频道的 chat id，形如 -1001234567890；获取方式见 README
RECEIVE_CHAT_ID=
# 私有备份频道的 chat id，两条路径最终都传到这里
ARCHIVE_CHAT_ID=
# 扫描接收频道的间隔，单位秒，默认 5 分钟
SCAN_INTERVAL_SECONDS=300
# 每轮最多处理的消息数，默认 10。账号安全优先，不要随意调高
BATCH_SIZE=10
# 每次上传文件后的冷却时间，单位秒，默认 5。给 Telegram 足够喘息空间
UPLOAD_COOLDOWN_SECONDS=5
# 归档失败重试上限：同一条消息累计失败 N 次后跳过/剔除并告警，原消息保留
RETRY_MAX_ATTEMPTS=3
# HTTP 代理地址，形如 http://127.0.0.1:10086。不需要代理则留空
HTTP_PROXY=
# tdl 下载后端
TDL_NAMESPACE=archiver
TDL_THREADS=4           # 单文件分块下载线程数上限
TDL_LIMIT=2             # 同时下载的任务数
TDL_DELAY_SECONDS=1     # 每个下载任务之间的间隔（秒）
TDL_TIMEOUT_SECONDS=0   # 进程超时，0 表示不超时

# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO
LOG_LEVEL=INFO
